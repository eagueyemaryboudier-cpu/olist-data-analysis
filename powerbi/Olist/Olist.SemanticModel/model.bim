                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"order_id\", type text}, {\"order_item_id\", Int64.Type}, {\"product_id\", type text}, {\"seller_id\", type text}, {\"price\", type number}, {\"freight_value\", type number}}, \"en-US\")",
