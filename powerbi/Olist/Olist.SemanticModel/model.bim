    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/CHANGE_ME/olist-data-analysis/powerbi/Olist/Data/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
